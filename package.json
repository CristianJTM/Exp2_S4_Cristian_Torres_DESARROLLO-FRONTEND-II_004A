{
  "name": "tienda-de-libros",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/spa-fallback.mjs",
    "build:pages": "vite build --mode pages && node scripts/spa-fallback.mjs",
    "preview": "vite preview",
    "predeploy": "npm run build:pages",
    "deploy": "gh-pages -d dist -b gh_pages --nojekyll"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "^7.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "gh-pages": "^6.3.0",
    "msw": "^2.7.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
